# Database
DATABASE_URL="postgresql://stemverse:stemverse_dev@localhost:5432/stemverse?schema=public"

# API (NestJS)
API_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Web (Next.js)
# Leave as /api to use Next.js rewrites (recommended), or set to http://localhost:4000/api for direct access
NEXT_PUBLIC_API_URL=/api

# AI Service (OpenRouter — optional; rule-based fallback works without key)
# Add OPENROUTER_API_KEY to local .env only — never commit keys.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Phase 5.1 model routing (aliases OPENROUTER_DEFAULT_MODEL / OPENROUTER_FALLBACK_MODEL)
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-r1-0528:free
OPENROUTER_MODEL_FAST=qwen/qwen3-32b:free
OPENROUTER_MODEL_FALLBACK=google/gemma-3-27b-it:free
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=STEMVerse
AI_STREAMING_ENABLED=true
AI_STREAM_TIMEOUT_MS=90000
AI_SERVICE_URL=http://127.0.0.1:4002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:4000/collaboration

# MinIO / S3 object storage (Phase 5.2A — add to local .env only)
MINIO_ROOT_USER=stemverse
MINIO_ROOT_PASSWORD=stemverse_minio_dev
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=stemverse
S3_SECRET_KEY=stemverse_minio_dev
S3_REGION=us-east-1
S3_PRESIGN_UPLOAD_EXPIRES=900
S3_PRESIGN_DOWNLOAD_EXPIRES=3600
