{
  "name": "stemverse",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:scratch": "pnpm --filter @stemverse/scratch-engine build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @stemverse/database generate",
    "db:migrate": "pnpm --filter @stemverse/database migrate",
    "db:push": "pnpm --filter @stemverse/database push",
    "db:studio": "pnpm --filter @stemverse/database studio"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
